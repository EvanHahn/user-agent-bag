{
  "name": "user-agent-bag",
  "version": "0.3.0",
  "description": "RFC-respecting User-Agent serialization and deserialization",
  "keywords": [
    "rfc7231",
    "user-agent",
    "useragent"
  ],
  "homepage": "https://github.com/EvanHahn/user-agent-bag",
  "bugs": "https://github.com/EvanHahn/user-agent-bag/issues",
  "license": "MIT",
  "author": "Evan Hahn <me@evanhahn.com> (https://evanhahn.com)",
  "repository": {
    "type": "git",
    "url": "git://github.com/EvanHahn/user-agent-bag.git"
  },
  "files": [
    "README.md",
    "LICENSE.txt",
    "CHANGELOG.md",
    "index.d.ts",
    "parser.js",
    "UserAgentBag.js"
  ],
  "main": "./UserAgentBag.js",
  "types": "./index.d.ts",
  "scripts": {
    "pretest": "npm run build && npm run lint",
    "build": "pegjs --output parser.js parser.pegjs",
    "lint": "npm run lint:oxlint && npm run lint:oxfmt",
    "lint:oxlint": "oxlint",
    "lint:oxfmt": "oxfmt --check",
    "format": "oxfmt",
    "test": "npm run test:node && npm run test:typescript",
    "test:node": "node --test",
    "test:typescript": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "oxfmt": "^0.42.0",
    "oxlint": "^1.57.0",
    "pegjs": "^0.10.0",
    "typescript": "^6.0.2"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
